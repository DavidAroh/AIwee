# AiWee backend configuration (all optional — the server runs with none of these)

# HTTP port
PORT=4000

# How far back a news article still counts as "live" (days)
INCIDENT_RECENCY_DAYS=30

# How often to poll news/social sources (minutes)
POLL_INTERVAL_MIN=15

# Comma-separated allowed CORS origins for browser clients.
# Default allows the Vite web app + Expo dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
