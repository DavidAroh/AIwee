VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase backend (optional) ───────────────────────────────────────────────
# When both are set, the app gets live incidents + SOS via Supabase Realtime
# (shared across all devices). When unset, it falls back to client-side
# collection (single device). See SUPABASE.md for setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
